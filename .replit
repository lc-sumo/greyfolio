# Replit: one service that builds the portal and serves API + portal on 8080.
# The development run command syncs the development schema. Production schema changes are owned
# by Replit's Publish flow; the production run command must not execute migrations or other DDL.
# Set Secrets first (see README "Launch checklist" and docs/DEPLOY.md):
#   DATABASE_URL (Replit PostgreSQL adds this), SESSION_SECRET (32+ chars),
#   BASE_URL and APP_ORIGIN (your repl URL), NODE_ENV=production, SEED=workbook on the first boot then none,
#   MAIL_PROVIDER / MAIL_API_KEY / MAIL_FROM when email is ready.
run = ["sh", "-c", "pnpm install --frozen-lockfile && pnpm portal:build && pnpm db:up && ([ \"${SEED:-none}\" = none ] || pnpm db:seed) && PORTAL_DIST=artifacts/portal/dist pnpm --filter @greystone/api-server start"]
entrypoint = "artifacts/api-server/src/index.ts"
modules = ["nodejs-22", "postgresql-16"]

[nix]
channel = "stable-24_05"

[env]
PORT = "8080"
PORTAL_DIST = "artifacts/portal/dist"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "pnpm install --frozen-lockfile && pnpm portal:build"]
run = ["sh", "-c", "PORTAL_DIST=\"$PWD/artifacts/portal/dist\" ./artifacts/api-server/node_modules/.bin/tsx artifacts/api-server/src/index.ts"]

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8099
externalPort = 8099

[[ports]]
localPort = 22289
externalPort = 3000

[userenv]

[userenv.production]
APP_ORIGIN = "https://folio.greystoneus.com"
BASE_URL = "https://folio.greystoneus.com"
MAIL_FROM = "Greystone Funded Portal <portal@greystoneus.com>"
MAIL_PROVIDER = "sendgrid"
NODE_ENV = "production"

[workflows]
runButton = "Project"

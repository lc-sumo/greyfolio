PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/greystone
SESSION_SECRET=change-me-to-a-long-random-string
# Where the browser lands after login (the React portal). Defaults to BASE_URL.
APP_ORIGIN=http://localhost:5173
BASE_URL=http://localhost:8080

# OIDC (authorization code + PKCE). Leave OIDC_ISSUER blank to disable.
OIDC_ISSUER=https://accounts.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid email profile

# AUTH_MODE=dev enables GET /auth/dev-login?email=… — refused when NODE_ENV=production.
AUTH_MODE=oidc

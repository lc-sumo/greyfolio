{
  "name": "@greystone/api-server",
  "version": "0.1.0",
  "private": true,
  "description": "Express API for the Greystone commission portal — OIDC auth, roles, server-side rep scoping, audit-logged View-as.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "import:sheet": "tsx src/import-sheet.ts"
  },
  "dependencies": {
    "@greystone/commission": "workspace:*",
    "@greystone/db": "workspace:*",
    "cookie-session": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "openid-client": "^6.8.7"
  },
  "devDependencies": {
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
